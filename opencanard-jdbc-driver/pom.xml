<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.opencanard</groupId>
		<artifactId>opencanard-parent</artifactId>
		<version>0.1</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>opencanard-jdbc-driver</artifactId>
	<packaging>jar</packaging>
	<name>OpenCanard JDBC Driver</name>
	<description>Minimal JDBC driver for OpenCanard Flight server (SELECT only)</description>
	<dependencies>
		<!-- Apache Arrow Flight (CLASSIC) -->
		<!-- Flight core implementation -->
		<dependency>
			<groupId>org.apache.arrow</groupId>
			<artifactId>flight-core</artifactId>
		</dependency>
		<!-- Arrow vector for schema & vectors -->
		<dependency>
			<groupId>org.apache.arrow</groupId>
			<artifactId>arrow-vector</artifactId>
		</dependency>
		<!-- Memory allocator for Arrow buffers -->
		<dependency>
			<groupId>org.apache.arrow</groupId>
			<artifactId>arrow-memory-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.arrow</groupId>
			<artifactId>arrow-memory-netty</artifactId>
		</dependency>
		<!-- (Optional) Flight SQL helpers -->
		<!-- Log4j2 API and Core -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
		</dependency>		
	</dependencies>
	<build>
		
		<resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.ico</include>
                    <include>**/*.png</include>
                    <include>**/*.xml</include>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>
		
		<plugins>
<plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<!-- create -all jar -->
							<finalName>${project.artifactId}-${project.version}-all</finalName>
							<!-- don't generate dependency-reduced-pom -->
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- Relocate the libraries that clash when the jar runs inside another application
							     (e.g. Denodo): the host's Netty / gRPC / Guava / Protobuf must not mix with ours.
							     Netty epoll/kqueue natives are not bundled, so Netty uses NIO. -->
							<relocations>
								<relocation><pattern>io.netty</pattern><shadedPattern>io.opencanard.shaded.io.netty</shadedPattern></relocation>
								<relocation><pattern>io.grpc</pattern><shadedPattern>io.opencanard.shaded.io.grpc</shadedPattern></relocation>
								<relocation><pattern>com.google.protobuf</pattern><shadedPattern>io.opencanard.shaded.com.google.protobuf</shadedPattern></relocation>
								<relocation><pattern>com.google.common</pattern><shadedPattern>io.opencanard.shaded.com.google.common</shadedPattern></relocation>
								<relocation><pattern>com.google.thirdparty</pattern><shadedPattern>io.opencanard.shaded.com.google.thirdparty</shadedPattern></relocation>
							</relocations>
							<artifactSet>
								<excludes>
									<exclude>io.netty:netty-transport-native-epoll</exclude>
									<exclude>io.netty:netty-transport-native-kqueue</exclude>
								</excludes>
							</artifactSet>
							<!-- required for JDBC ServiceLoader -->
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>io.opencanard.driver.jdbc.OpenCanardDriver</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
