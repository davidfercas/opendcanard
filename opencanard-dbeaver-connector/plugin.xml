<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<!--
  OpenCanard connector for DBeaver: an "OpenCanard" entry (with the logo) in the New Connection dialog.
  Same structure as DBeaver's own Generic-based entries (Elasticsearch, DuckDB...): a data source with
  parent="generic" and the Generic provider class. The connection page and the tree are inherited from "generic".
-->
<plugin>
    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <dataSourceType
                id="opencanard"
                label="OpenCanard"
                description="OpenCanard: DuckDB over Apache Arrow Flight"
                dataSourceInformation="DuckDB server with an Arrow Flight interface"
                icon="icons/opencanard_icon.png"
                iconBig="icons/opencanard_icon_big.png"/>
        <datasource
                class="org.jkiss.dbeaver.ext.generic.GenericDataSourceProviderBasic"
                description="OpenCanard JDBC connector"
                id="opencanard"
                dataSourceType="opencanard"
                parent="generic"
                label="OpenCanard"
                icon="icons/opencanard_icon.png"
                dialect="generic">
            <drivers managable="true">
                <driver
                        id="opencanard_jdbc"
                        label="OpenCanard"
                        icon="icons/opencanard_icon.png"
                        iconBig="icons/opencanard_icon_big.png"
                        class="io.opencanard.driver.jdbc.OpenCanardDriver"
                        sampleURL="jdbc:opencanard://{host}[:{port}]"
                        defaultPort="8815"
                        webURL="https://github.com/davidfercas/opendcanard"
                        description="OpenCanard JDBC driver (Arrow Flight, port 8815 by default)"
                        supportedConfigurationTypes="MANUAL,URL"
                        categories="sql,analytic">
                    <!-- The driver jar is packed into the bundle by build.ps1 / build.sh when it has been built.
                         If DBeaver reports a missing file, add the jar by hand: Database > Driver Manager >
                         OpenCanard > Libraries > Add File (opencanard-jdbc-driver-0.1-all.jar). -->
                    <file type="jar" path="drivers/opencanard-jdbc-driver-0.1-all.jar" bundle="org.opencanard.dbeaver.connector"/>
                </driver>
            </drivers>
        </datasource>
    </extension>
</plugin>
